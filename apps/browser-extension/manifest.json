{
  "manifest_version": 3,
  "name": "Simplism",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Open published Simplism guides on sites you enable.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Simplism", "default_popup": "popup.html" }
}
